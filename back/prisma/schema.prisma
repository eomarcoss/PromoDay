// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Criamos o Enum com as regras de tipos de usuários
enum Role {
  CUSTOMER
  SELLER
}

enum ClaimStatus {
  PENDING
  USED
  EXPIRED
  CANCELLED
}

// 1. Tabela dos Clientes (Usuários finais)
model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  password  String
  avatarUrl String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims Claim[]
  @@map("customers")
}

// 2. Tabela dos Vendedores / Lojas (Sellers)
model Seller {
  id               String      @id @default(uuid())
  name             String
  phone            String
  email            String      @unique
  password         String
  avatarUrl        String?
  address          String      
  businessHours    Json        
  category         String      
  role             Role        @default(SELLER)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  promotions       Promotion[] // Relacionamento com as futuras promoções
}

model Promotion {
  id              String   @id @default(uuid())
  name            String
  description     String?  // 👈 Opcional (?)
  requirements    String?  // 👈 Requisitos da oferta (ex: "Apenas para primeira compra") - Opcional (?)
  stock           Int      // Estoque disponível da promoção
  limitPerUser    Int      // Limite que cada cliente pode resgatar
  
  startTime       DateTime // Horário de início da oferta
  endTime         DateTime // Horário de fim da oferta
  
  originalPrice   Float    // O famoso preço "De"
  promoPrice      Float    // O preço promocional "Por"
  
  images          String[] // 👈 Array de strings para suportar múltiplas fotos do produto!
  isActive        Boolean  @default(true)
  // Relacionamento com o Vendedor
  sellerId        String
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  claims          Claim[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Claim {
  id          String    @id @default(uuid())
  code        String    @unique // Código legível para o balcão (ex: PD-X8Y2Z)
  status      ClaimStatus @default(PENDING) // PENDING, USED, EXPIRED
  quantity    Int       @default(1)
  // Relacionamento com o Cliente (Quem está resgatando)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Relacionamento com a Promoção
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  claimedAt   DateTime  @default(now())
  usedAt      DateTime? // Gravado apenas quando o lojista validar o código

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 🔒 A REGRA DE OURO DO SEU MODELO:
  // Cria uma chave primária composta fictícia. Isso impede que exista mais de um registro PENDING para o mesmo Customer na mesma Promotion.
  // É graças a isso que o comando `this.prisma.claim.findUnique({ where: { customerId_promotionId: { ... } } })` funciona no seu Service!
  @@unique([customerId, promotionId])
}